        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "It lived in the same environments as Rampardos. Their fossils have been found together— seemingly from after they’d fought to the finish.",
