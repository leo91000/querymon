        "language": {
          "name": "ja-Hrkt",
          "url": "https://pokeapi.co/api/v2/language/1/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "Faute de nourriture, la population de Grotadmorv diminue rapidement. Pour éviter son extinction, des étangs de fange artificiels ont été creusés.",
