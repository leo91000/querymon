        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "エサが　減って　数も　激減。 絶滅を　防ぐため　人工の ヘドロ池が　作られ始めた。",
        "language": {
