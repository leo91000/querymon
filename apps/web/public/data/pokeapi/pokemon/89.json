          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "The stench it gives off will make your nose scrunch up. Still, there are Muk fans who think that’s a good thing.",
