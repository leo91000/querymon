        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "After recent environmental improvements, this Pokémon is now hardly seen at all. People speculate that it may go extinct at some point.",
