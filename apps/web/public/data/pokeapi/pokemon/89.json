          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "とにかく　鼻が　曲がるほど　臭い。 だが　一部には　それがいいと　いう ベトベトンマニアも　存在する。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "かんきょうが　せいびされた　さいきんは めっきり　すがたを　みなくなった。 いずれ　ぜつめつすると　いわれている。",
