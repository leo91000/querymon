        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "La puanteur qu’il dégage est presque insoutenable. Mais certains aficionados trouvent que c’est ce qui fait son charme.",
