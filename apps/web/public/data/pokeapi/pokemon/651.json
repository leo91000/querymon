        }
      },
      {
        "flavor_text": "La carapace qui recouvre son corps le protège des attaques adverses, et ses piquants lui permettent de contre-attaquer.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
