          "url": "https://pokeapi.co/api/v2/version/24/"
        }
      },
      {
        "flavor_text": "Il renforce ses membres inférieurs en se ruant violemment sur ses congénères. Naturellement paisible, il ne provoque jamais un combat.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
