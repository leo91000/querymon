        }
      },
      {
        "flavor_text": "鋭い　刃を　操り　敵を 追い詰める。　河原の　石で 体の　刃を　手入れする。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
