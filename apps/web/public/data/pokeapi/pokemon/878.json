    "flavor_text_entries": [
      {
        "flavor_text": "５トンの　にもつを　もっても へいきな　ちからもち　ポケモン。 はなを　つかって　つちを　ほる。",
        "language": {
          "name": "ja-Hrkt",
          "url": "https://pokeapi.co/api/v2/language/1/"
        },
        "version": {
          "name": "sword",
          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "Ce Pokémon est assez costaud pour porter des charges de cinq tonnes sans problème. Il utilise sa trompe pour creuser le sol.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "sword",
          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "It digs up the ground with its trunk. It’s also very strong, being able to carry loads of over five tons without any problem at all.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "sword",
          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "５トンの　荷物を　もっても 平気な　力持ち　ポケモン。 鼻を　使って　土を　掘る。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "sword",
          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "ちからしごとなら　おまかせ。 どうの　からだは　あめで　さび あざやかな　みどりに　かわる。",
        "language": {
          "name": "ja-Hrkt",
          "url": "https://pokeapi.co/api/v2/language/1/"
        },
        "version": {
          "name": "shield",
          "url": "https://pokeapi.co/api/v2/version/34/"
        }
      },
      {
        "flavor_text": "Les travaux physiques, c’est son affaire. Son corps de cuivre rouille sous la pluie et prend une vive couleur verte.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "shield",
          "url": "https://pokeapi.co/api/v2/version/34/"
        }
      },
      {
        "flavor_text": "If a job requires serious strength, this Pokémon will excel at it. Its copper body tarnishes in the rain, turning a vibrant green color.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "shield",
          "url": "https://pokeapi.co/api/v2/version/34/"
        }
      },
      {
        "flavor_text": "力仕事なら　お任せ。 銅の　体は　雨で　錆び 鮮やかな　緑に　変わる。",
        "language": {
          "name": "ja",
