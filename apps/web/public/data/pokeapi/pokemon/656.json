        }
      },
      {
        "flavor_text": "Sa poitrine et son dos sécrètent une mousse qui lui permet de subir moins de dégâts en amortissant le choc des attaques.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
