      {
        "flavor_text": "D’ordinaire violent, il vous mange littéralement dans la main si vous lui donnez des fruits mûrs, son mets favori.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
