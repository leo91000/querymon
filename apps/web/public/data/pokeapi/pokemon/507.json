      {
        "flavor_text": "Son poil long et très dur, pousse à une vitesse ahurissante, et son toilettage coûte un bras. Une plaie à élever.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
