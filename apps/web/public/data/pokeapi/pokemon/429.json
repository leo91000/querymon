          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "祟りや　呪いを　振りまくとして 恐れられて　きた。　気まぐれに 人を助ける　呪文も　使う。",
