    "flavor_text_entries": [
      {
        "flavor_text": "いきだおれたものの　おんねんが こどもが　つくった　すなやまに とりつき　たんじょう　したのだ。",
        "language": {
          "name": "ja-Hrkt",
          "url": "https://pokeapi.co/api/v2/language/1/"
        },
        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "Ce Pokémon est né de la rancœur d’un voyageur mort dans l’indifférence, laquelle s’est incarnée dans un pâté de sable.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "Born from a sand mound playfully built by a child, this Pokémon embodies the grudges of the departed.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "行き倒れた者の　怨念が 子どもが　つくった　砂山に 取りつき　誕生　したのだ。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "くちのなかに　てを　いれたものを あやつってしまう。　すなやまの からだを　おおきく　させるためだ。",
        "language": {
          "name": "ja-Hrkt",
          "url": "https://pokeapi.co/api/v2/language/1/"
        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "Ceux qui ont le malheur de mettre la main dans sa gueule deviennent ses pantins. Il est prêt à tout pour agrandir son corps en forme de dune.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "It takes control of anyone who puts a hand in its mouth. And so it adds to the accumulation of its sand-mound body.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "口の中に　手を　入れた者を 操ってしまう。　砂山の 身体を　大きく　させるためだ。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "あたまの　スコップは　おきにいり。 とりかえしにきた　こどもと　ケンカ。 ムキに　なって　なぐりあいに　なる。",
        "language": {
          "name": "ja-Hrkt",
          "url": "https://pokeapi.co/api/v2/language/1/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "Il tient beaucoup à la pelle sur sa tête. Si un enfant cherche à la récupérer, il se bat sans retenir ses coups pour la garder.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "It likes the shovel on its head, so Sandygast will get serious and fight any children who come to take it back.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "頭の　スコップは　お気に入り。 取り返しに　来た　子どもと　ケンカ。 ムキに　なって　殴り合いに　なる。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "すなあそびで　つくった　すなやまは かえるとき　こわさないと　たましいが やどり　スナバァに　なるかもしれない。",
        "language": {
          "name": "ja-Hrkt",
          "url": "https://pokeapi.co/api/v2/language/1/"
        },
        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "Détruisez vos pâtés de sable avant de rentrer chez vous, sinon une âme pourrait les posséder et les transformer en Bacabouh.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "If you build sand mounds when you’re playing, destroy them before you go home, or they may get possessed and become Sandygast.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "砂遊びで　作った　砂山は 帰るとき　壊さないと　魂が 宿り　スナバァに　なるかもしれない。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "すなやまに　ししゃの　おんねんが やどり　ポケモンに　なった。 あたまの　スコップは　おきにいり。",
        "language": {
          "name": "ja-Hrkt",
          "url": "https://pokeapi.co/api/v2/language/1/"
        },
        "version": {
          "name": "sword",
          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "Ce Pokémon est né lorsqu’une âme rancunière s’est incarnée dans un pâté de sable. Il tient énormément à la pelle sur sa tête.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "sword",
          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "Grudges of the dead have possessed a mound of sand and become a Pokémon. Sandygast is fond of the shovel on its head.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "sword",
          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "砂山に　死者の　怨念が　宿り ポケモンに　なった。 頭の　スコップは　お気に入り。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "sword",
          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "すなはまが　おもな　すみか。 くちのなかに　てをいれた　あいてを あやつり　じぶんを　おおきくする。",
        "language": {
          "name": "ja-Hrkt",
          "url": "https://pokeapi.co/api/v2/language/1/"
        },
        "version": {
          "name": "shield",
          "url": "https://pokeapi.co/api/v2/version/34/"
        }
      },
      {
        "flavor_text": "Il vit principalement sur les plages de sable et peut agrandir son corps en prenant le contrôle des gens qui mettent la main dans sa gueule.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "shield",
          "url": "https://pokeapi.co/api/v2/version/34/"
        }
      },
      {
        "flavor_text": "Sandygast mainly inhabits beaches. It takes control of anyone who puts their hand into its mouth, forcing them to make its body bigger.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "shield",
          "url": "https://pokeapi.co/api/v2/version/34/"
        }
      },
      {
        "flavor_text": "砂浜が　おもな　棲み処。 口の中に　手を入れた　相手を 操り　自分を　大きくする。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "shield",
          "url": "https://pokeapi.co/api/v2/version/34/"
        }
      }
    ]
  }
