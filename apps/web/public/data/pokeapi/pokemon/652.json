    "flavor_text_entries": [
      {
        "flavor_text": "Il est si puissant qu’il pourrait renverser un char de 50 t d’un seul assaut. Il se sert de son corps comme d’un bouclier pour protéger ses alliés.",
        "language": {
          "name": "fr",
