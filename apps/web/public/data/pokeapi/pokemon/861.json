          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "With the hair wrapped around its body helping to enhance its muscles, this Pokémon can overwhelm even Machamp.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
