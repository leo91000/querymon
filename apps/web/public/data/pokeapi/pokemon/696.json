          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "Ce Pokémon ancien a été ranimé à partir d’un fossile. Égoïste et violent, il peut détruire n’importe quoi avec son énorme mâchoire.",
