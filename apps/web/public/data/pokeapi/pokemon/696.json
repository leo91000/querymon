      },
      {
        "flavor_text": "Its large jaw has incredible destructive power. Some theories suggest that its restored form is different from its form of long ago.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
