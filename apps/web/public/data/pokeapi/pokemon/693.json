          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "取り込んだ　水を　圧縮して 撃ちだす。　分厚い　鉄板に 穴を　開けるほどの　威力だ。",
