        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "La chair de sa pince droite est très ferme. Les pinces tombées sont vendues à l’étranger comme ingrédients de cuisine.",
