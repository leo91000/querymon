    "flavor_text_entries": [
      {
        "flavor_text": "Il transforme des jets d’eau sous pression en redoutables shuriken. Une fois lancés, ils tournent si vite qu’ils peuvent même couper le métal.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "x",
          "url": "https://pokeapi.co/api/v2/version/23/"
        }
      },
      {
        "flavor_text": "It creates throwing stars out of compressed water. When it spins them and throws them at high speed, these stars can split metal in two.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "x",
          "url": "https://pokeapi.co/api/v2/version/23/"
        }
      },
      {
        "flavor_text": "水を　圧縮して　手裏剣を　作り出す。 高速回転させて　飛ばすと 金属も　真っ二つ。",
        "language": {
          "name": "ja",
