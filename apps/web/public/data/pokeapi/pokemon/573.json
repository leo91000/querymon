          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "チリひとつ　ゆるせない　けっぺき。 からだ　から　しみでる　あぶらを すに　ぬりつけ　コーティングする。",
