          "name": "ja-Hrkt",
          "url": "https://pokeapi.co/api/v2/language/1/"
        },
        "version": {
          "name": "sword",
          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "Il ne supporte pas de voir le moindre grain de poussière. Il utilise l’huile qu’il sécrète pour recouvrir son nid d’un revêtement protecteur.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "sword",
          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "Its body secretes oil that this Pokémon spreads over its nest as a coating to protect it from dust. Cinccino won’t tolerate even a speck of the stuff.",
