          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "全身から　染み出す　油は とても　なめらか。　肌荒れに 悩む人にも　効果的なのだ。",
