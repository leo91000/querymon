          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "フライゴンの　おこす　すなあらしに みを　ひそめて　えものが　くるのを じっと　まちかまえている。",
