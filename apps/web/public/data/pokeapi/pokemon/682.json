        }
      },
      {
        "flavor_text": "Son corps dégage un parfum qui envoûte ceux qui le respirent et change en fonction de son alimentation.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
