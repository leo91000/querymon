        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "Lorsqu’il n’aboie pas pour effrayer ses adversaires, ce Pokémon aime se la couler douce et dort 12 h par jour.",
