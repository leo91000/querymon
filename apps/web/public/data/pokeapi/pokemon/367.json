        "version": {
          "name": "alpha-sapphire",
          "url": "https://pokeapi.co/api/v2/version/26/"
        }
      },
      {
        "flavor_text": "Ce piètre nageur se sert de sa queue pour appâter ses proies. Il les gobe si elles approchent de trop près.",
