        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "On pense qu’il protège les Pokémon affaiblis parce qu’il partage avec eux les mêmes prédateurs.",
