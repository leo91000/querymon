        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "Il se laisse dériver au gré des courants océaniques profonds. De nombreux Pokémon Eau se rassemblent toujours autour de lui.",
