        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "羽は　火を　通さず　丈夫。 昔の　消防士の　服は ファイアローの　羽で　できていた。",
