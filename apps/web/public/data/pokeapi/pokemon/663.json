        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "Son plumage résistant est ignifugé. Jadis, la combinaison portée par les pompiers était faite de plumes de Flambusard.",
