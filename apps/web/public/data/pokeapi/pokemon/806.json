      },
      {
        "flavor_text": "クネクネ動いて　人に　近付くと 突然　頭を　爆発させた。 ウルトラビーストの　一種らしい。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
