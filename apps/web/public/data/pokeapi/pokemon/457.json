          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "海底に　棲む　深海のポケモン。 ヒレを使い　海底を　はって 好物の　スターミーを　探す。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "La nourriture étant très rare dans les abysses marins, Luminéon doit souvent se disputer ses précieuses proies avec Lanturn.",
