          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "Dans son monde, cette Ultra-Chimère est fort appréciée pour son naturel conciliant, qui fait d’elle un compagnon de voyage idéal.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
