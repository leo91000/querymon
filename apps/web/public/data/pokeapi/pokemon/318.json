          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "If they scent the faintest trace of blood, they rush to attack en masse. When alone, they’re rather cowardly.",
