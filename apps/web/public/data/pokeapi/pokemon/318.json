        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "En banc, il guette l’odeur du sang et fond sur sa proie sans aucune pitié. Seul, il se montre plus timoré.",
