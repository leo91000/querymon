        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "Grâce à sa mâchoire d’acier et ses dents acérées, il déchiquette sans peine les canots. Bargantua et lui se disputent le menu fretin.",
