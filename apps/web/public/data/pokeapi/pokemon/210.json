        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "Sa mâchoire est étonnamment puissante, mais comme il n’aime pas se battre, il n’a pas souvent l’occasion de s’en servir.",
