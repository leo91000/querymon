          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "sword",
          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "手のひらから　出る　水分を 丸めて　つくった　水の　玉を 使い　頭脳戦を　繰り広げる。",
        "language": {
          "name": "ja",
