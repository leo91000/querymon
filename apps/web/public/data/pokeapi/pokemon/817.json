        "version": {
          "name": "shield",
          "url": "https://pokeapi.co/api/v2/version/34/"
        }
      },
      {
        "flavor_text": "Paresseux, mais malin, il parsème son territoire de pièges pour empêcher ses ennemis d’y pénétrer.",
