          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "こうてつなみの　いしあたまで やたら　めったら　ずつきする。 そらを　とべない　ストレスの　せいだ。",
