        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "あたまを　つよく　うちつける　ことで しんかに　えいきょうする　さいぼうを しげきしている　というせつも　ある。",
        "language": {
          "name": "ja-Hrkt",
