          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "空を飛ぶ　とりポケモンを　見るたび 羨ましくなって　ヘッドバッドで あたりのものを　粉々に　砕く。",
