          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "そこらの道端に　いくらでも　いる。 ヒマな　学者が　数えてみたら １つの道路に　１００匹　いた。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "ながく　いきた　イシツブテは　かどが とれて　まんまる。　せいかくも　とても おちついていて　おだやか　なのだ。",
