        "version": {
          "name": "sword",
          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "おんこうな　せいしつだが　おこると こわい。　てっこつをも　きりさく じまんの　キバを　おみまい　するぞ。",
