          "name": "ja-Hrkt",
          "url": "https://pokeapi.co/api/v2/language/1/"
        },
        "version": {
          "name": "y",
          "url": "https://pokeapi.co/api/v2/version/24/"
        }
      },
      {
        "flavor_text": "Il utilise ses ailes pour contrôler avec précision sa posture en vol. Ses attaques aériennes sont difficiles à parer.",
