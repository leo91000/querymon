    "flavor_text_entries": [
      {
        "flavor_text": "Ce Pokémon apparaît lorsqu’un esprit possède un arbre en décomposition. Il vit dans les forêts où les humains n’osent pas s’aventurer.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
