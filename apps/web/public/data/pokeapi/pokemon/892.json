    "flavor_text_entries": [
      {
        "flavor_text": "Adepte des techniques pouvant mettre K.O. en un seul coup, il se jette sur son adversaire et le frappe de son poing robuste.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
