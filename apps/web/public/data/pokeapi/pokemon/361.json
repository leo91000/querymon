        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "Il ne peut voir le jour que dans les plus froides contrées. Il s’accommode parfaitement de températures atteignant les -100 °C.",
