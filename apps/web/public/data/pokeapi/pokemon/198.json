        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "They awaken at dusk and take wing in the twilight, leading to the expression, “Get home before the Murkrow fly.”",
