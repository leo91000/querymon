          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "shield",
          "url": "https://pokeapi.co/api/v2/version/34/"
        }
      },
      {
        "flavor_text": "すみかに　している　ティーカップは 有名な　アンティークの　食器。 多くの　贋作が　出回っている。",
