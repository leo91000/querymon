        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "Sa docilité en fait un Pokémon facile à élever. Il est notamment populaire auprès des Dresseurs débutants.",
