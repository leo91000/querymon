        },
        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "Ce Pokémon est courageux, mais prudent. Les poils doux qui recouvrent son visage lui permettent de sonder les alentours.",
