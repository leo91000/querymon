          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "判断力に　優れた　ポケモン。 勝てない　相手と　判断したら さっさと　シッポを　巻いて　逃げる。",
