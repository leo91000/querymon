          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "Il habite au fond des grottes et, bien à l’abri au creux de sa solide carapace, il rêve du jour où il pourra enfin s’envoler dans les cieux.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
