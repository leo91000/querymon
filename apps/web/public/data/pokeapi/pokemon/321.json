        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "They eat so many fish Pokémon that when Wailord become too numerous, fishermen have to chase them off.",
