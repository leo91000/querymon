    "flavor_text_entries": [
      {
        "flavor_text": "L’une des mystérieuses Ultra-Chimères. On l’aurait vue parasiter des gens en pleine rue, les rendant extrêmement violents.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "One of several mysterious Ultra Beasts. People on the street report observing those infested by it suddenly becoming violent.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "謎に　包まれた　ＵＢの　一種。 街ゆく　人が　寄生され 暴れだす　姿が　目撃された。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "Nul ne sait si cette Ultra-Chimère possède une conscience propre, mais on l’aurait aperçue en train d’imiter les gestes d’une jeune fille.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "One of the Ultra Beasts. It’s unclear whether or not this Pokémon is sentient, but sometimes it can be observed behaving like a young girl.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "ＵＢの　一種。　意思が　あるかは 不明だが　時折　少女の ような　仕草を　みせる。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "Une forme de vie d’un autre monde, communément appelée « Ultra-Chimère ». On la pense porteuse d’une violente neurotoxine.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "A life-form from another world, it was dubbed a UB and is thought to produce a strong neurotoxin.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "ＵＢと　呼ばれる　別世界の 生命体。　強い　神経毒を 持っていると　考えられる。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "Il est venu dans ce monde à travers une Ultra-Brèche. Tel un parasite, il aurait besoin d’un hôte, Pokémon ou humain, pour survivre.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "It appeared in this world from an Ultra Wormhole. Nihilego appears to be a parasite that lives by feeding on people and Pokémon.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "ウルトラホールから　この世界に 現れた。　ポケモンや　人間に 寄生して　生きているようだ。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      }
    ]
