          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "What gives meaning to its life is surprising others. If you set your ear against the red orbs around its neck, you can hear shrieking.",
