        }
      },
      {
        "flavor_text": "La reconstitution de Pokémon est un art imparfait. D’aucuns pensent même qu’il était en fait couvert d’une robe semblable à un plumage.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "Complete restoration is impossible, allowing room for theories that its entire body was once covered in a feather-like coat.",
