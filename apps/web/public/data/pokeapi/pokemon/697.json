        "version": {
          "name": "sword",
          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "おおあごは　ひとかみするだけで じどうしゃも　こなごなに　する。 こだいの　せかいの　おうじゃ。",
