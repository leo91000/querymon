          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "完全な　復元は　不可能で 実は　全身に　羽毛の　ような 毛が　あるのではという　説がある。",
