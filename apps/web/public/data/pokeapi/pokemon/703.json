    "flavor_text_entries": [
      {
        "flavor_text": "Ce Pokémon vient des profondeurs de la terre, où la chaleur et la pression sont intenses. La pierre qui orne sa tête émet de l’énergie.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "x",
          "url": "https://pokeapi.co/api/v2/version/23/"
        }
      },
      {
        "flavor_text": "Born from the temperatures and pressures deep underground, it fires beams from the stone in its head.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "x",
          "url": "https://pokeapi.co/api/v2/version/23/"
        }
      },
      {
        "flavor_text": "地下深くの　高温　高圧な 環境で　生まれた。 頭の　石から　エネルギーを　放つ。",
