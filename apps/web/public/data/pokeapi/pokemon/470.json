          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "争いは　好まないが　仲間を 守るためならば　シッポの　葉っぱを 尖らせ　刃に変えて　戦う。",
