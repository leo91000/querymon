          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "若い　リーフィアほど　ツンと　くる 青臭い　匂い。　年老いると 落ち葉の　ような　匂いになる。",
