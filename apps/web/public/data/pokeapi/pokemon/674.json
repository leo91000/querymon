    "flavor_text_entries": [
      {
        "flavor_text": "Il fait de son mieux pour avoir un air patibulaire, mais il sourit béatement dès qu’on lui caresse la tête.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
