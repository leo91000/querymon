          "url": "https://pokeapi.co/api/v2/version/23/"
        }
      },
      {
        "flavor_text": "こうげきを　うけても　ひるまずに とっしんして　でんちゅうを　へしおる パワーの　わんりょくで　ぶちのめす。",
        "language": {
          "name": "ja-Hrkt",
