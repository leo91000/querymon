        }
      },
      {
        "flavor_text": "Ce Pokémon agressif a recours à la force pour faire taire ceux qui le contrarient. Il adore combattre les Ixon.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
