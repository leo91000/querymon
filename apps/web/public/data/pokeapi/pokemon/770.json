    "flavor_text_entries": [
      {
        "flavor_text": "Il a possédé un humain pour que ce dernier le remodèle en château de sable, décuplant au passage ses pouvoirs de malédiction.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "Possessed people controlled by this Pokémon transformed its sand mound into a castle. As it evolved, its power to curse grew ever stronger.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "人を　操り　砂の山を 砂の城まで　進化　させた。 呪いの　力も　あがっている。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "sun",
          "url": "https://pokeapi.co/api/v2/version/27/"
        }
      },
      {
        "flavor_text": "On trouve de nombreux ossements sous ses tours, restes de pauvres hères capturés. Leur énergie a servi à nourrir ce Pokémon.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "Buried beneath the castle are masses of dried-up bones from those whose vitality it has drained.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "城の　下には　精気を　吸われ 干からびた　者たちの　骨が 大量に　埋まっている。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "moon",
          "url": "https://pokeapi.co/api/v2/version/28/"
        }
      },
      {
        "flavor_text": "Chacun de ses grains de sable a sa volonté propre. Trépassable gobe de petits Pokémon pour absorber leur énergie vitale.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "Each of its grains of sand has its own will. Palossand eats small Pokémon and siphons away their vital essence while they’re still alive.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "一粒の　砂にも　意思が　ある。 小さな　ポケモンを　呑み込み 生きたまま　生気を　奪う。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "Ce terrifiant Pokémon déclenche des tempêtes de sable pour immobiliser ses victimes, puis absorbe leur énergie vitale.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "Once it has whipped up a sandstorm to halt its opponents in their tracks, this terrifying Pokémon snatches away their vitality.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "砂嵐を　巻き起こし　相手の 身動きを　封じてから　生気を 奪う　恐ろしい　ポケモンだ。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "ultra-moon",
          "url": "https://pokeapi.co/api/v2/version/30/"
        }
      },
      {
        "flavor_text": "On l’appelle aussi le « cauchemar des plages ». Il contrôle le sable pour ensevelir ses proies et aspirer leur âme.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "sword",
          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "Palossand is known as the Beach Nightmare. It pulls its prey down into the sand by controlling the sand itself, and then it sucks out their souls.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "sword",
          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "ビーチの　悪夢とも　呼ばれる。 砂を　操って　獲物を　沈め 魂を　吸い取る。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "sword",
          "url": "https://pokeapi.co/api/v2/version/33/"
        }
      },
      {
        "flavor_text": "Bien qu’il déteste l’eau, il vit sur les plages. Quand la pluie s’abat sur lui, il est incapable de conserver sa forme de château de sable.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "shield",
          "url": "https://pokeapi.co/api/v2/version/34/"
        }
      },
      {
        "flavor_text": "This Pokémon lives on beaches, but it hates water. Palossand can’t maintain its castle-like shape if it gets drenched by a heavy rain.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "shield",
          "url": "https://pokeapi.co/api/v2/version/34/"
        }
      },
      {
        "flavor_text": "ビーチに　棲むが　水が　嫌い。 激しい　雨に　打たれると お城の　形を　保てない。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "shield",
          "url": "https://pokeapi.co/api/v2/version/34/"
        }
      }
    ]
  }
