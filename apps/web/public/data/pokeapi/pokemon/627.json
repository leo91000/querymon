          "name": "ja-Hrkt",
          "url": "https://pokeapi.co/api/v2/language/1/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "Grâce à ses pattes puissantes et à ses serres robustes, il arrive même à briser la coquille de Kokiyas pour se délecter de son contenu.",
        "language": {
          "name": "fr",
          "url": "https://pokeapi.co/api/v2/language/5/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "With its powerful legs and sturdy claws, it can crack even the hard shells of Shellder and pluck out their insides.",
        "language": {
          "name": "en",
          "url": "https://pokeapi.co/api/v2/language/9/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "強い　脚力と　丈夫な　ツメで 硬い　シェルダーの　カラも 砕いて　中身を　ついばむ。",
        "language": {
          "name": "ja",
          "url": "https://pokeapi.co/api/v2/language/11/"
        },
        "version": {
          "name": "ultra-sun",
          "url": "https://pokeapi.co/api/v2/version/29/"
        }
      },
      {
        "flavor_text": "うまれながらの　せんしと　よばれる。 うまれて　すぐに　おやに　いどみ みとめてもらわなければ　いけない。",
