# Local dev uses SQLite file at ./var/dev.db (no env needed)
# For Turso (production/staging), set the following:
# TURSO_DATABASE_URL=https://<db-name>-<org>.turso.io
# TURSO_AUTH_TOKEN=...
# Turso management (for per-user DB provisioning)
# TURSO_API_TOKEN=...               # Turso API token (not a group/db auth token)
# TURSO_ORG_SLUG=myorg              # org slug used in API URLs
# TURSO_GROUP_NAME=default          # group to place user DBs in
# TURSO_DB_TOKEN_TTL=7d             # issued token TTL (e.g., 1h, 24h, 7d)
# TURSO_GROUP_TOKEN=...             # optional: server-side token to access any DB in group

# Server port
# PORT=8787

# Better Auth (Google)
# BETTER_AUTH_SECRET=dev-secret-change-me
# BETTER_AUTH_URL=http://localhost:8787
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
