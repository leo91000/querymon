# Database (PostgreSQL)
# DB_DRIVER=pg        # 'pg' or 'neon' (default pg)
# DATABASE_URL=postgres://user:pass@localhost:5432/querymon
# MIGRATE_ON_BOOT=true  # Run migrations on startup (default false)

# Server port
# PORT=8787

# Better Auth (Google)
# BETTER_AUTH_SECRET=dev-secret-change-me
# BETTER_AUTH_URL=http://localhost:8787
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
