{
  "name": "@querymon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:push": "drizzle-kit push --config ./drizzle.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.4",
    "@hono/trpc-server": "^0.4.0",
    "@libsql/client": "^0.15.15",
    "@trpc/server": "^11.6.0",
    "better-auth": "^1.3.5",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.8",
    "ws": "^8.18.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.3.17",
    "@types/node": "^24.5.2",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
