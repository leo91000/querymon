{
  "name": "querymon",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "scrape": "node scripts/scrape.mjs",
    "dev:web": "concurrently -k -n API,WEB -c blue,green \"pnpm --filter @querymon/api dev\" \"pnpm --filter @querymon/web dev\"",
    "build:web": "pnpm --filter @querymon/web build",
    "serve:web": "pnpm --filter @querymon/web serve",
    "dev:api": "pnpm --filter @querymon/api dev",
    "build:api": "pnpm --filter @querymon/api build",
    "start:api": "pnpm --filter @querymon/api start",
    "dev:desktop": "pnpm --filter @querymon/desktop dev",
    "build:desktop": "pnpm --filter @querymon/desktop build",
    "typecheck": "pnpm --filter @querymon/api typecheck && pnpm --filter @querymon/web typecheck && pnpm --filter @querymon/desktop typecheck",
    "typecheck:all": "concurrently -k -n API,WEB,DESK -c blue,green,magenta \"pnpm --filter @querymon/api typecheck\" \"pnpm --filter @querymon/web typecheck\" \"pnpm --filter @querymon/desktop typecheck\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@hono/node-server": "^1.19.4",
    "@hono/trpc-server": "^0.4.0",
    "@libsql/client": "^0.15.15",
    "@trpc/client": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@types/lodash-es": "^4.17.12",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.8",
    "lodash-es": "^4.17.21",
    "ws": "^8.18.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@better-auth/cli": "^1.3.18",
    "@types/node": "^24.5.2",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.36.0",
    "eslint-plugin-solid": "^0.14.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@libsql/hrana-client": "0.8.0"
    }
  }
}
