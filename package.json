{
  "name": "querymon",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "scrape": "node scripts/scrape.mjs",
    "dev:web": "pnpm --filter './packages/*' build && concurrently -k -n API,WEB,TRPC -c blue,green,cyan \"pnpm --filter @querymon/api dev\" \"pnpm --filter @querymon/web dev\" \"pnpm --filter @querymon/trpc dev\"",
    "build:web": "pnpm --filter @querymon/web build",
    "serve:web": "pnpm --filter @querymon/web serve",
    "dev:api": "pnpm --filter @querymon/api dev",
    "build:api": "pnpm --filter @querymon/api build",
    "start:api": "pnpm --filter @querymon/api start",
    "dev:desktop": "pnpm --filter @querymon/desktop dev",
    "build:desktop": "pnpm --filter @querymon/desktop build",
    "typecheck": "pnpm --filter './packages/*' build && concurrently -n TRPC,API,WEB,DESK -c cyan,blue,green,magenta \"pnpm --filter @querymon/trpc typecheck\" \"pnpm --filter @querymon/api typecheck\" \"pnpm --filter @querymon/web typecheck\" \"pnpm --filter @querymon/desktop typecheck\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@trpc/client": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@types/lodash-es": "^4.17.12",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "lodash-es": "^4.17.21",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@better-auth/cli": "^1.3.27",
    "@types/node": "^24.7.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.37.0",
    "eslint-plugin-solid": "^0.14.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {},
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "better-sqlite3",
      "esbuild",
      "prisma"
    ]
  }
}
